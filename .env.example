# Copy to .env and replace every CHANGE_ME value. .env is ignored by Git.
# Docker Compose reads this file automatically. The Java app and tools ALSO read it
# as their lowest-precedence configuration source (environment variables win).

# --- PostgreSQL bootstrap superuser (used only by the container on first start) ---
POSTGRES_PASSWORD=CHANGE_ME_bootstrap_password

# --- Migration owner: owns the schema, runs database/migrations (mvnw exec:java@migrate) ---
CLASSSYNC_MIGRATOR_USER=classsync_migrator
CLASSSYNC_MIGRATOR_PASSWORD=CHANGE_ME_migrator_password

# --- Restricted application user: SELECT/INSERT/UPDATE/DELETE only, used by the desktop app ---
CLASSSYNC_APP_DB_USER=classsync_app
CLASSSYNC_APP_DB_PASSWORD=CHANGE_ME_app_password

# --- Host connection (JavaFX running on Windows/host). Inside Compose use host "postgres". ---
DB_PORT=5432
CLASSSYNC_DB_URL=jdbc:postgresql://localhost:5432/classsync
# Disposable database used by integration tests (wiped by the tests!)
CLASSSYNC_TEST_DB_URL=jdbc:postgresql://localhost:5432/classsync_test

# --- Application settings ---
CLASSSYNC_TIMEZONE=Asia/Kolkata
CLASSSYNC_UPLOAD_DIR=uploads
CLASSSYNC_EMAIL_PATTERN=^[a-z0-9._-]+@college\.edu$
CLASSSYNC_MAX_UPLOAD_MB=20
CLASSSYNC_ATTENDANCE_CODE_SECONDS=120
